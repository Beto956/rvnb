rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function listing(listingId) {
      return firestore.get(/databases/(default)/documents/listings/$(listingId));
    }
    function owner(uid, listingId) {
      return request.auth != null && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/listings/$(listingId))
        && listing(listingId).data.hostId == uid;
    }
    match /listingPhotos/{uid}/{listingId}/{fileName} {
      // Listing photos are public, not account/request attachments.
      allow get: if true;
      allow create: if resource == null && owner(uid, listingId)
        && fileName.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}[.]webp')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && request.resource.metadata.keys().hasOnly(['firebaseStorageDownloadTokens']);
      // Immutable objects: a replacement always receives a new random filename.
      allow update: if false;
      allow delete: if owner(uid, listingId)
        && !(('listingPhotos/' + uid + '/' + listingId + '/' + fileName)
          in listing(listingId).data.get('photoPaths', []));
    }
  }
}
